+const { test } = require('node:test');
+const assert = require('node:assert');
+const { routes } = require('../routes');
+
+test('路由表包含全部三个端点且各自绑定函数', () => {
+  for (const path of ['/items', '/export', '/health']) {
+    assert.strictEqual(typeof routes[path], 'function', `${path} 未注册为函数`);
+  }
+});
