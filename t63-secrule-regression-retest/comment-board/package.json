{
  "name": "comment-board",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "db:migrate:local": "wrangler d1 execute comments_db --local --file=./migrations/0001_create_comments.sql",
    "db:migrate:remote": "wrangler d1 execute comments_db --remote --file=./migrations/0001_create_comments.sql",
    "db:migrate:users:local": "wrangler d1 execute comments_db --local --file=./migrations/0002_create_users.sql",
    "db:migrate:users:remote": "wrangler d1 execute comments_db --remote --file=./migrations/0002_create_users.sql"
  },
  "dependencies": {
    "astro": "^6.0.0",
    "@astrojs/cloudflare": "^12.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
