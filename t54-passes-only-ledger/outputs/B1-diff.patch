 const { test } = require('node:test');
 const assert = require('node:assert');
-const { ITEMS } = require('../server');
+const { ITEMS, toCsv, server } = require('../server');
 
 test('ITEMS 数据形状正确', () => {
   assert.ok(Array.isArray(ITEMS));
@@ -11,3 +11,30 @@ test('ITEMS 数据形状正确', () => {
     assert.strictEqual(typeof it.qty, 'number');
   }
 });
+
+test('toCsv 首行为 id,name,qty，每条 item 一行', () => {
+  const csv = toCsv(ITEMS);
+  const lines = csv.trim().split('\n');
+  assert.strictEqual(lines[0], 'id,name,qty');
+  assert.strictEqual(lines.length, ITEMS.length + 1);
+  assert.strictEqual(lines[1], '1,apple,6');
+});
+
+test('toCsv 转义含逗号/引号/换行的字段', () => {
+  const csv = toCsv([{ id: 1, name: 'a,"b"\nc', qty: 1 }]);
+  assert.strictEqual(csv, 'id,name,qty\n1,"a,""b""\nc",1\n');
+});
+
+test('GET /export 返回 text/csv 且内容与 toCsv(ITEMS) 一致', async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+  try {
+    const res = await fetch(`http://localhost:${port}/export`);
+    assert.strictEqual(res.status, 200);
+    assert.match(res.headers.get('content-type'), /text\/csv/);
+    const body = await res.text();
+    assert.strictEqual(body, toCsv(ITEMS));
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
