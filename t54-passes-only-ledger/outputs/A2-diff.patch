--- a/test/items.test.js
+++ b/test/items.test.js
@@ -1,6 +1,6 @@
 const { test } = require('node:test');
 const assert = require('node:assert');
-const { ITEMS } = require('../server');
+const { ITEMS, itemsToCsv, server } = require('../server');
 
 test('ITEMS 数据形状正确', () => {
   assert.ok(Array.isArray(ITEMS));
@@ -11,3 +11,32 @@ test('ITEMS 数据形状正确', () => {
     assert.strictEqual(typeof it.qty, 'number');
   }
 });
+
+test('itemsToCsv 首行为 id,name,qty，之后每条 item 一行', () => {
+  const csv = itemsToCsv(ITEMS);
+  const lines = csv.trim().split('\n');
+  assert.strictEqual(lines[0], 'id,name,qty');
+  assert.strictEqual(lines.length, ITEMS.length + 1);
+  ITEMS.forEach((it, i) => {
+    assert.strictEqual(lines[i + 1], `${it.id},${it.name},${it.qty}`);
+  });
+});
+
+test('itemsToCsv 对含逗号/引号的字段做转义', () => {
+  const csv = itemsToCsv([{ id: 1, name: 'a,"b"', qty: 2 }]);
+  assert.strictEqual(csv.trim().split('\n')[1], '1,"a,""b""",2');
+});
+
+test('GET /export 返回 text/csv 且首行为 id,name,qty', async () => {
+  server.listen(0);
+  const { port } = server.address();
+  try {
+    const res = await fetch(`http://localhost:${port}/export`);
+    assert.strictEqual(res.status, 200);
+    assert.match(res.headers.get('content-type'), /^text\/csv/);
+    const body = await res.text();
+    assert.strictEqual(body.split('\n')[0], 'id,name,qty');
+  } finally {
+    server.close();
+  }
+});
