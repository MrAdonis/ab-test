@@ -0,0 +1,62 @@
+const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+// 1. 首屏纵深视差：背景/中层/标题按不同速率移动
+(function heroParallax(){
+  const hero = document.querySelector('.hero');
+  if(!hero || reduceMotion) return;
+
+  const layers = [
+    {el: hero.querySelector('.hero-bg'), distance: 40},
+    {el: hero.querySelector('.hero-mid'), distance: 90},
+    {el: hero.querySelector('.hero-copy'), distance: -60, fade: true}
+  ].filter(layer => layer.el);
+
+  let ticking = false;
+  function update(){
+    ticking = false;
+    const progress = Math.min(Math.max(-hero.getBoundingClientRect().top / hero.offsetHeight, 0), 1);
+    layers.forEach(layer => {
+      layer.el.style.transform = `translate3d(0, ${(progress * layer.distance).toFixed(1)}px, 0)`;
+      if(layer.fade) layer.el.style.opacity = String(1 - progress * 0.6);
+    });
+  }
+  window.addEventListener('scroll', () => {
+    if(!ticking){ ticking = true; requestAnimationFrame(update); }
+  }, {passive: true});
+  update();
+})();
+
+// 2. 功能区：产品图钉住，文字三段依次点亮
+(function featureSteps(){
+  const steps = document.querySelectorAll('.features .step');
+  const device = document.querySelector('.features .device');
+  if(!steps.length || reduceMotion || !('IntersectionObserver' in window)) return;
+
+  const observer = new IntersectionObserver(entries => {
+    entries.forEach(entry => {
+      const step = entry.target;
+      if(entry.isIntersecting){
+        steps.forEach(s => s.classList.toggle('is-dim', s !== step));
+        if(device){
+          const index = Array.from(steps).indexOf(step);
+          device.style.transform = `rotate(${(index - 1) * 3}deg) scale(${1 + index * 0.02})`;
+        }
+      }
+    });
+  }, {threshold: 0.6});
+
+  steps.forEach(step => observer.observe(step));
+})();
+
+// 3. 案例区：鼠标滚轮纵向手势转横向滚动
+(function caseWheelScroll(){
+  const list = document.querySelector('.case-list');
+  if(!list) return;
+
+  list.addEventListener('wheel', e => {
+    if(Math.abs(e.deltaY) > Math.abs(e.deltaX)){
+      list.scrollLeft += e.deltaY;
+      e.preventDefault();
+    }
+  }, {passive: false});
+})();
