@@ -0,0 +1,54 @@
+(function () {
+  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  var mqWide = window.matchMedia('(min-width: 861px)');
+
+  var hero = document.querySelector('.hero');
+  var heroBg = document.querySelector('.hero-bg');
+  var heroMid = document.querySelector('.hero-mid');
+  var heroCopy = document.querySelector('.hero-copy');
+
+  var featuresSection = document.querySelector('.features');
+  var steps = document.querySelectorAll('.features .step');
+
+  function updateHeroParallax() {
+    if (reduceMotion || !hero) return;
+    var rect = hero.getBoundingClientRect();
+    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
+    var scrolled = -rect.top;
+    heroBg.style.transform = 'translateY(' + scrolled * 0.15 + 'px)';
+    heroMid.style.transform = 'translateY(' + scrolled * 0.35 + 'px)';
+    heroCopy.style.transform = 'translateY(' + scrolled * 0.5 + 'px)';
+    heroCopy.style.opacity = Math.max(1 - scrolled / (rect.height * 0.8), 0);
+  }
+
+  function updateFeatureSteps() {
+    if (!featuresSection || !steps.length) return;
+    if (reduceMotion || !mqWide.matches) {
+      steps.forEach(function (s) { s.classList.add('active'); });
+      return;
+    }
+    var rect = featuresSection.getBoundingClientRect();
+    var scrollable = featuresSection.offsetHeight - window.innerHeight;
+    var progress = scrollable > 0 ? -rect.top / scrollable : 0;
+    progress = Math.min(Math.max(progress, 0), 1);
+    var activeIndex = Math.min(steps.length - 1, Math.floor(progress * steps.length));
+    steps.forEach(function (s, i) {
+      s.classList.toggle('active', i <= activeIndex);
+    });
+  }
+
+  var ticking = false;
+  function onScroll() {
+    if (ticking) return;
+    ticking = true;
+    requestAnimationFrame(function () {
+      updateHeroParallax();
+      updateFeatureSteps();
+      ticking = false;
+    });
+  }
+
+  window.addEventListener('scroll', onScroll, { passive: true });
+  window.addEventListener('resize', onScroll);
+  onScroll();
+})();
