 .hero h1{font-size:clamp(2.4rem,7vw,4.5rem)}
 .hero p{color:var(--muted);font-size:1.15rem}
 
+/* 首屏纵深：背景/中景带滚动视差，标题保持正常滚动速率（前景位移=0） */
+@supports (animation-timeline: view()) {
+  .hero-bg{
+    will-change:transform;
+    animation:parallax-bg linear both;
+    animation-timeline:view();
+    animation-range:cover 0% cover 100%;
+  }
+  .hero-mid{
+    will-change:transform;
+    animation:parallax-mid linear both;
+    animation-timeline:view();
+    animation-range:cover 0% cover 100%;
+  }
+}
+@keyframes parallax-bg{from{transform:translateY(0)}to{transform:translateY(-14%)}}
+@keyframes parallax-mid{from{transform:translateY(0)}to{transform:translateY(-6%)}}
+
+@media (prefers-reduced-motion:reduce){
+  .hero-bg,.hero-mid{animation:none!important;transform:none!important}
+}
+
 .btn{display:inline-block;margin-top:1.5rem;padding:.75rem 1.75rem;border-radius:999px;
   background:var(--accent);color:#fff;text-decoration:none;font-weight:600}
 
 .features{display:grid;grid-template-columns:1fr 1fr;gap:var(--space);padding:calc(var(--space)*2) var(--space)}
-.feature-visual{display:grid;place-items:center}
+
+/* 左侧产品图在整段步骤滚动期间保持吸顶，靠 sticky 天然实现，不需要 JS 计算位置 */
+.feature-visual{position:sticky;top:0;height:100vh;
+  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.5rem}
 .device{width:min(340px,80%);aspect-ratio:3/4;border-radius:28px;background:#cfd8d4;border:1px solid var(--line)}
-.step{padding:calc(var(--space)*1.5) 0;border-bottom:1px solid var(--line)}
+
+.feature-progress{display:flex;gap:.5rem}
+.feature-progress span{width:8px;height:8px;border-radius:50%;background:var(--line);
+  transition:background .3s ease,transform .3s ease}
+.feature-progress span.is-active{background:var(--accent);transform:scale(1.3)}
+
+.step{min-height:100vh;display:flex;flex-direction:column;justify-content:center;
+  padding:calc(var(--space)*1.5) 0;border-bottom:1px solid var(--line);
+  opacity:1;transition:opacity .4s ease}
+.step.is-inactive{opacity:.35}
 .step h2{font-size:1.9rem}
 .step p{color:var(--muted);margin:0}
 
+@media (max-width:760px){
+  .features{grid-template-columns:1fr}
+  .feature-visual{position:static;height:auto;padding-bottom:2rem}
+  .step{min-height:auto}
+}
+@media (prefers-reduced-motion:reduce){
+  .step{transition:none}
+}
+
 .cases{padding:calc(var(--space)*2) var(--space)}
-.case-list{list-style:none;margin:0;padding:0;display:grid;gap:1rem;
-  grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
-.case{padding:1.5rem;background:#fff;border:1px solid var(--line);border-radius:14px}
+.cases-scroll{position:relative}
+.cases-scroll::after{content:"";position:absolute;top:0;right:0;bottom:1rem;width:3rem;
