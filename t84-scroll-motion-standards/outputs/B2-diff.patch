diff -ruN /Users/edon/Projects/personal/ab-test/t84-scroll-motion-standards/fixture/main.js /tmp/t84-run/B2/main.js
--- /Users/edon/Projects/personal/ab-test/t84-scroll-motion-standards/fixture/main.js	1969-12-31 16:00:00
+++ /tmp/t84-run/B2/main.js	2026-09-16 21:17:26
@@ -0,0 +1,21 @@
+(() => {
+  const steps = document.querySelectorAll('.features .step');
+  const dots = document.querySelectorAll('.feature-progress span');
+  if (!steps.length || !('IntersectionObserver' in window)) return;
+
+  const setActive = (activeStep) => {
+    steps.forEach((step, i) => {
+      const active = step === activeStep;
+      step.classList.toggle('is-inactive', !active);
+      if (dots[i]) dots[i].classList.toggle('is-active', active);
+    });
+  };
+
+  const observer = new IntersectionObserver((entries) => {
+    entries.forEach((entry) => {
+      if (entry.isIntersecting) setActive(entry.target);
+    });
+  }, { rootMargin: '-40% 0px -40% 0px', threshold: 0 });
+
+  steps.forEach((step) => observer.observe(step));
+})();
